# WhatsPro — self-hosted WhatsApp marketing suite (100% free, no Meta Cloud API)
#
# Copy to ".env" and fill what you need. Nothing here is mandatory to boot:
# without GEMINI_API_KEY the bot answers with your keyword rules instead.

# Optional: enables Gemini smart replies in the bot + playground.
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: port for the all-in-one server (API + web UI).
PORT="3000"

# Optional: where JSON data + WhatsApp session files live (default: ./server-data).
WA_DATA_DIR=""

# Supabase (persistent DB, mirrors server-data JSON via kv_store table)
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Per-client license key (Electron installs). Owner issues keys from Supabase licenses table.
LICENSE_KEY=""
